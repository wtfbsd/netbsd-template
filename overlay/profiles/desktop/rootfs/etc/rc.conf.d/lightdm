# rc(8) load_rc_config only reads /etc/rc.conf.d/<service-name>, so this
# fragment is named after the lightdm rc script (the pkgsrc lightdm
# package installs it). A NetBSD rc variable is <name>=YES - there is no
# <name>_enable.
lightdm=YES
