#!/bin/sh
# tests/stubs/bin/nbgpt — a stand-in for nbgpt(8), the GPT utility of the
# NetBSD tools directory.
#
# Copyright (c) 2026 The wtfbsd contributors. BSD-2-Clause (see LICENSE).
#
# The stub appends its argv to $STUB_LOG and keeps the partition layout it
# was given in a state file next to the image. "show" prints a listing in
# the gpt(8) format — start, size, index and contents columns, with the
# PMBR, the primary GPT header and the primary GPT table first — so that
# the build's offset parsing is exercised on the real shape of the output.
#
# "create" never truncates the image: the image is written by dd(1) and
# the GPT is written into it.
#
# The real command form is: nbgpt <device> <subcommand> [options...]; the
# device comes first, and "show" takes only the device. Any argument the
# command does not accept is refused with "illegal option" (create/add) so
# that a build that hands the tool an option it does not have is caught
# here and not on the build host.

: "${STUB_LOG:?STUB_LOG must point at the stub log}"

PROG=nbgpt

illegal() {
	printf '%s: illegal option -- %s\n' "$PROG" "$1" >&2
	exit 1
}

needs_arg() {
	printf '%s: option %s requires an argument\n' "$PROG" "$1" >&2
	exit 1
}

printf '%s\n' "nbgpt $*" >> "$STUB_LOG"

# the real form is: nbgpt <device> <subcommand> [options...]. A leading
# option is never valid, so it is refused as an illegal option here, exactly
# as the other stubs refuse an option the command does not have.
device=$1
case $device in
	-*) illegal "$1" ;;
esac
[ $# -ge 2 ] || {
	printf '%s: expected <device> <subcommand>\n' "$PROG" >&2
	exit 1
}
shift
cmd=${1:-}
[ $# -ge 1 ] && shift

# to_blocks <size> — a size like 64m as a count of 512-byte blocks
to_blocks() {
	_s=$1
	_u=1
	case $_s in
	*[kK]) _u=1024; _s=${_s%?} ;;
	*[mM]) _u=1048576; _s=${_s%?} ;;
	*[gG]) _u=1073741824; _s=${_s%?} ;;
	esac
	case $_s in
	'' | *[!0-9]*) return 1 ;;
	esac
	printf '%d\n' $((_s * _u / 512))
}

case $cmd in
create)
	while [ $# -gt 0 ]; do
		case $1 in
		-s)
			[ $# -ge 2 ] || needs_arg "$1"
			shift 2
			;;
		-f | -n | -r | -v | -p)
			shift
			;;
		-*)
			illegal "$1"
			;;
		*)
			printf '%s: %s: unexpected argument to create\n' "$PROG" "$1" >&2
			exit 1
			;;
		esac
	done
	# the image is written by dd(1): it is never truncated here
	[ -f "$device" ] || : > "$device"
	: > "$device.gptstate"
	;;
add)
	type=''
	size=''
	index=''
	label=''
	while [ $# -gt 0 ]; do
		case $1 in
		-t)
			[ $# -ge 2 ] || needs_arg "$1"
			type=${2:-}
			shift 2
			;;
		-s)
			[ $# -ge 2 ] || needs_arg "$1"
			size=${2:-}
			shift 2
			;;
		-i)
			[ $# -ge 2 ] || needs_arg "$1"
			index=${2:-}
			shift 2
			;;
		-l)
			[ $# -ge 2 ] || needs_arg "$1"
			label=${2:-}
			shift 2
			;;
		-a | -b)
			# gpt(8) add: -a alignment and -b start each take an
			# argument
			[ $# -ge 2 ] || needs_arg "$1"
			shift 2
			;;
		-f | -n | -r | -v | -p)
			shift
			;;
		-*)
			illegal "$1"
			;;
		*)
			printf '%s: %s: unexpected argument to add\n' "$PROG" "$1" >&2
			exit 1
			;;
		esac
	done
	blocks=$(to_blocks "${size:-0}") || exit 1
	printf '%s\t%s\t%s\t%s\n' "${index:-0}" "$type" "$blocks" "${label:-}" >> "$device.gptstate"
	;;
show)
	# show takes only the device: any option is refused
	while [ $# -gt 0 ]; do
		case $1 in
		-*)
			illegal "$1"
			;;
		*)
			printf '%s: %s: unexpected argument to show\n' "$PROG" "$1" >&2
			exit 1
			;;
		esac
		shift
	done
	img="$device"
	state="$device.gptstate"
	[ -f "$state" ] || exit 1
	bytes=$(wc -c < "$img" | tr -d ' ')
	sectors=$((bytes / 512))
	{
		printf 'Disk: %s %s bytes\n' "$img" "$bytes"
		printf 'Sector size: 512 bytes, %s sectors\n' "$sectors"
		printf '%12s %12s %6s  %s\n' start size index contents
		printf '%12d %12d %6d  %s\n' 40 16 1 'PMBR'
		printf '%12d %12d %6d  %s\n' 56 16 2 'Pri GPT header'
		printf '%12d %12d %6d  %s\n' 72 512 3 'Pri GPT table'
	} > "$device.gptshow"
	cursor=584
	while IFS='	' read -r index type blocks label; do
		[ -n "$index" ] || continue
		printf '%12d %12d %6d  %s\n' "$cursor" "$blocks" "$index" "${label:-$type}" >> "$device.gptshow"
		cursor=$((cursor + blocks))
	done < "$state"
	sed 's/^/gpt-show: /' "$device.gptshow" >> "$STUB_LOG"
	cat "$device.gptshow"
	;;
label)
	while [ $# -gt 0 ]; do
		case $1 in
		-l)
			[ $# -ge 2 ] || needs_arg "$1"
			shift 2
			;;
		-n | -r | -v)
			shift
			;;
		-*)
			illegal "$1"
			;;
		*)
			printf '%s: %s: unexpected argument to label\n' "$PROG" "$1" >&2
			exit 1
			;;
		esac
	done
	[ -f "$device.gptstate" ] || exit 1
	printf '%s\n' "$label" >> "$device.gptstate"
	;;
destroy)
	while [ $# -gt 0 ]; do
		case $1 in
		-f | -n | -p | -r | -v)
			shift
			;;
		-*)
			illegal "$1"
			;;
		*)
			printf '%s: %s: unexpected argument to destroy\n' "$PROG" "$1" >&2
			exit 1
			;;
		esac
	done
	[ -n "$device" ] || exit 1
	rm -f "$device.gptstate" "$device.gptshow"
	;;
*)
	printf 'nbgpt: unknown subcommand: %s\n' "$cmd" >&2
	exit 1
	;;
esac
